# ===== 桥接监听（本地）。cloudflared 会把它暴露成公网 wss:// =====
HOST=127.0.0.1
PORT=8787
WS_PATH=/agent

# ===== 鉴权：公网可达，务必设一个长随机 token！=====
# 生成： openssl rand -hex 32
# ESP32 连接时带同样的值（Authorization: Bearer <token> 或 URL ?token=<token>）
# 留空 = 不鉴权（仅限本机调试，切勿公网暴露）
AUTH_TOKEN=

# ===== Claude Code（Claude Agent SDK 驱动）=====
ANTHROPIC_API_KEY=sk-ant-...
# Claude Code 的工作目录：它能在这里读写文件、跑命令。指向你信任的项目目录。
WORKSPACE_DIR=/path/to/your/project
# 权限模式： default(每次问) | acceptEdits(自动批准改文件,推荐) | bypassPermissions(全自动,慎用) | plan(只读)
PERMISSION_MODE=acceptEdits
# 留空用默认模型；也可指定 claude-sonnet-4-6 等
CLAUDE_MODEL=
# 可选：用已安装的 claude（而非 SDK 自带二进制）。例： which claude 的结果
CLAUDE_EXECUTABLE=
MAX_TURNS=50

# ===== 语音转文字 STT（可插拔）=====
STT_PROVIDER=openai          # openai | whispercpp | none
STT_MODEL=whisper-1
# 本地 whisper.cpp server（STT_PROVIDER=whispercpp 时用）
WHISPER_URL=http://127.0.0.1:8081/inference

# ===== 文字转语音 TTS（可插拔）=====
TTS_PROVIDER=openai          # openai | piper | none
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# 本地 Piper server（TTS_PROVIDER=piper 时用）
PIPER_URL=http://127.0.0.1:5000

# ===== STT/TTS 用 OpenAI 时的凭据 =====
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
